# Use only after the domain is registered and its ICP filing is complete.
# Replace study.example.cn and certificate paths with actual values.
server {
    listen 443 ssl http2;
    server_name study.example.cn;
    ssl_certificate /etc/letsencrypt/live/study.example.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/study.example.cn/privkey.pem;
    root /opt/zhijian/site;
    index index.html;
    client_max_body_size 32k;

    location = /cloud-config.js {
        add_header Cache-Control "no-store";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /healthz {
        proxy_pass http://127.0.0.1:8000;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
